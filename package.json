{
    "name": "homerepair",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "db:generate": "pnpm --filter @homerepair/data db:generate",
        "db:push": "pnpm --filter @homerepair/data db:push",
        "db:migrate": "pnpm --filter @homerepair/data db:migrate",
        "db:studio": "pnpm --filter @homerepair/data db:studio"
    },
    "devDependencies": {
        "turbo": "^2.5.0",
        "typescript": "^5.8.0"
    },
    "packageManager": "pnpm@10.12.1",
    "engines": {
        "node": ">=20"
    }
}
