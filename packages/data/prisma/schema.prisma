// Generates the client INSIDE this package (not node_modules) so pnpm's
// strict linking never causes resolution issues in the consuming apps.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

/**
 * *****************
 * Company Data
 * *****************
 */
model Organization {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name     String
  timezone String  @default("America/Los_Angeles") // IANA identifier
  phone    String?

  companies   Company[]
  memberships Membership[]

  @@map("organizations")
}

enum TenantStatus {
  Trial
  Active
  Paused
  Churned
}

model Company {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  status   TenantStatus
  slug     String       @unique
  name     String
  timezone String       @default("America/Los_Angeles") // IANA identifier
  phone    String?

  address_id String
  address    CompanyAddress @relation(fields: [address_id], references: [id])

  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])

  booking_setting  CompanyBookingSetting?
  brand_setting    CompanyBrandSetting?
  bookings        CompanyBooking[]
  memberships      Membership[]
  company_services CompanyService[]
  appliance_types  ApplianceType[]
  brands           Brand[]
  brand_rules      CompanyBrandRule[]
  symptoms         Symptom[]
  symptom_rules    CompanySymptomRule[]
  customers Customer[]

  @@unique([address_id])
  @@index([organization_id])
  @@map("companies")
}

model User {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  email          String    @unique
  password_hash  String
  first_name     String
  last_name      String?
  deactivated_at DateTime?

  membership Membership[]

  @@map("users")
}

enum MembershipRole {
  Owner
  Admin
  Staff
}

model Membership {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  role MembershipRole

  user_id String
  user    User   @relation(fields: [user_id], references: [id])

  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])

  // null company_id means its an org level membership
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])

  @@unique([user_id, company_id])
  @@index([organization_id])
  @@index([company_id])
  @@map("memberships")
}

model CompanyService {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  enabled              Boolean @default(true)
  // This is the default job duration time
  job_duration_minutes Int

  appliance_type_id String
  appliance_type    ApplianceType @relation(fields: [appliance_type_id], references: [id])
  company_id        String
  company           Company       @relation(fields: [company_id], references: [id])

  bookings CompanyBooking[]
  duration_overrides CompanyServiceDurationOverride[]

  @@unique([company_id, appliance_type_id])
  @@map("company_services")
}

enum Font {
  Poppins
}

model CompanyBrandSetting {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  primary_color   String @default("#0F6E56")
  secondary_color String @default("#E1F5EE")
  selected_fill   String @default("#E1F5EE")
  selected_text   String @default("#085041")
  body_text       String @default("#000000")
  button_text     String @default("#FFFFFF")
  page_background String @default("#F5F7F6")

  corner_radius Int     @default(12)
  font          Font    @default(Poppins)
  logo_url      String?

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  @@unique([company_id])
  @@map("company_brand_settings")
}

model CompanyBookingSetting {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  default_window_length_minutes   Int
  allowed_jobs_per_window Int

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  days_of_the_week DayOfWeekSetting[]

  @@unique([company_id])
  @@map("company_booking_settings")
}

enum Weekday {
  Sunday
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
}

model DayOfWeekSetting {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  is_open        Boolean
  week_day  Weekday

  open_at  String @default("09:00") @db.VarChar(5)
  close_at String @default("17:00") @db.VarChar(5)

  company_booking_setting_id String
  company_booking_setting    CompanyBookingSetting @relation(fields: [company_booking_setting_id], references: [id])

  @@unique([company_booking_setting_id, week_day])
  @@map("day_of_week_settings")
}

enum BookingStatus {
  Scheduled
  InProgress
  Completed
  Cancelled
}

model CompanyBooking {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  status BookingStatus @default(Scheduled)
  completed_at DateTime?
  cancelled_at DateTime?
  start_time DateTime
  end_time DateTime
  booked_timezone String

  // Address Snapshot
  line1 String
  line2 String? 
  city        String
  // ISO 3166-2
  state    String   @db.VarChar(3)
  postal_code String @db.VarChar(10)
  // ISO 3166-1 alpha-2
  country     String @db.VarChar(2) @default("US")
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  company_service_id String
  company_service CompanyService @relation(fields: [company_service_id], references: [id])

  appliance_brand_id String?
  appliance_brand Brand? @relation(fields: [appliance_brand_id], references: [id])

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  customer_id String
  customer Customer @relation(fields: [customer_id], references: [id])

  booking_symptoms BookingSymptom[]

  // Ordered by company_id, then start_time — a company's bookings sit
  // contiguously, so a date range is one slice, already in sort order.
  @@index([company_id, start_time])
  @@map("company_bookings")
}

model BookingSymptom {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company_booking_id String
  company_booking CompanyBooking @relation(fields: [company_booking_id], references: [id])

  symptom_id String
  symptom Symptom @relation(fields: [symptom_id], references: [id])

  @@unique([company_booking_id, symptom_id])
  @@map("booking_symptoms")
}

model Customer {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  phone String
  first_name String
  last_name String
  email String?

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  addresses CustomerAddress[]
  bookings CompanyBooking[]

  @@unique([company_id, phone])
  @@map("customers")
}

model CompanyServiceDurationOverride {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  duration_minutes Int

  company_service_id String
  company_service    CompanyService @relation(fields: [company_service_id], references: [id])

  brand_id String?
  brand    Brand?  @relation(fields: [brand_id], references: [id])

  symptom_id String?
  symptom    Symptom? @relation(fields: [symptom_id], references: [id])

  @@index([company_service_id])
  @@map("company_service_duration_overrides")
}

enum BrandRuleType {
  Allow
  Deny
  Prefer
}

model CompanyBrandRule {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  rule BrandRuleType

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  brand_id String
  brand    Brand  @relation(fields: [brand_id], references: [id])

  // Can blacklist a brand or a brand's fridge/stove/oven/etc..
  appliance_type_id String?
  appliance_type    ApplianceType? @relation(fields: [appliance_type_id], references: [id])

  @@index([company_id])
  @@map("company_brand_rules")
}

model ApplianceType {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name String

  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])

  symptoms            Symptom[]
  model_tag_locations ModelTagLocation[]
  company_services    CompanyService[]
  brand_rules         CompanyBrandRule[]

  @@index([company_id])
  @@map("appliance_types")
}

model Symptom {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name        String
  description String

  // A company can create their own symptem, otherwise they're system defaults
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])

  appliance_type_id String
  appliance_type    ApplianceType @relation(fields: [appliance_type_id], references: [id])

  brand_id                           String?
  brand                              Brand?                           @relation(fields: [brand_id], references: [id])
  company_service_duration_overrides CompanyServiceDurationOverride[]
  symptom_rules                      CompanySymptomRule[]
  bookings                           BookingSymptom[]

  @@index([company_id])
  @@index([appliance_type_id])
  @@map("symptoms")
}

enum SymptomRuleType {
  Enabled
  Disabled
}

model CompanySymptomRule {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  rule SymptomRuleType

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  symptom_id String
  symptom    Symptom @relation(fields: [symptom_id], references: [id])

  @@index([company_id, symptom_id])
  @@map("symptom_rules")
}

model ModelTagLocation {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  appliance_type_id String
  appliance_type    ApplianceType @relation(fields: [appliance_type_id], references: [id])

  brand_id String?
  brand    Brand?  @relation(fields: [brand_id], references: [id])

  @@index([appliance_type_id, brand_id])
  @@map("model_tag_locations")
}

model Brand {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  name    String
  // Alternate names to check for to ensure dupe isn't created
  aliases String[]

  // Brands can belong to the system or to a company
  // Duplicate check against existing system brands 
  // On creation to avoid dupes
  company_id                 String?
  company                    Company?                         @relation(fields: [company_id], references: [id])
  model_tag_locations        ModelTagLocation[]
  service_duration_overrides CompanyServiceDurationOverride[]
  brand_rules                CompanyBrandRule[]
  symptoms                   Symptom[]
  bookings                     CompanyBooking[]

  @@index([company_id])
  @@map("brands")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  label String?
  is_primary Boolean @default(false)

  // Street address
  line1 String // "123 Main St"
  line2 String? // apt / unit / suite / floor

  city        String
  // ISO 3166-2
  state    String   @db.VarChar(3)
  postal_code String @db.VarChar(10)
  // ISO 3166-1 alpha-2
  country     String @db.VarChar(2) @default("US")

  // Geocoding — powers tech dispatch, routing, and distance/radius search.
  // Nullable: populated asynchronously after the address is entered.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  customer_id String 
  customer Customer @relation(fields: [customer_id], references: [id])

  @@index([customer_id])
  @@map("customer_addresses")
}

model CompanyAddress {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Street address
  line1 String // "123 Main St"
  line2 String? // apt / unit / suite / floor

  city        String
  // ISO 3166-2
  state    String   @db.VarChar(3)
  postal_code String @db.VarChar(10)
  // ISO 3166-1 alpha-2
  country     String @db.VarChar(2) @default("US")

  // Geocoding — powers tech dispatch, routing, and distance/radius search.
  // Nullable: populated asynchronously after the address is entered.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  company Company?
  @@map("company_addresses")
}
